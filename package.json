{
  "name": "rent2wipes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Renzo Vibes – statische Künstlerseite (Vite + React + TanStack Router, GitHub Pages)",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "dev:merch": "vite --mode merch-sandbox",
    "shop:sandbox": "node --disable-warning=ExperimentalWarning shop/sandbox.mjs",
    "feeds": "node scripts/update-feeds.ts",
    "fetch-media": "node scripts/fetch-media.ts",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.ts",
    "build": "node scripts/check-config.ts && npm run build:client && npm run build:server && npm run prerender",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run && node --disable-warning=ExperimentalWarning --test shop/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-router": "1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-xml-parser": "^5.2.5",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.3.8",
    "vitest": "^4.1.10"
  }
}
