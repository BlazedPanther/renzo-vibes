{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Hauptadresse ist www.renzovibes.com (Railway terminiert HTTPS)
	@apex host renzovibes.com
	redir @apex https://www.renzovibes.com{uri} permanent

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	@assets path /assets/* /media/* /thumbs/*
	header @assets Cache-Control "public, max-age=604800"

	# Ordner-Seiten: /music -> /music/index.html
	try_files {path} {path}/index.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
