{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	@apex host renzovibes.com
	redir @apex https://www.renzovibes.com{uri} permanent

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	@assets path /assets/* /media/* /thumbs/*
	header @assets Cache-Control "public, max-age=604800"

	redir /datenschutz /privacy permanent
	redir /datenschutz/ /privacy permanent

	@merch path /api/merch/* /merch-admin /merch-admin/*
	handle @merch {
		reverse_proxy 127.0.0.1:8788
	}
	handle {
		try_files {path} {path}/index.html
		file_server
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
